# Copy to .env on the BACKEND host only. Never commit .env. Placeholders only.

# Live trading is not implemented. Any value other than "paper" makes startup fail.
TRADING_MODE=paper
PAPER_STARTING_BALANCE_USD=1000

# Data source. "none" = no market data (everything UNKNOWN, all BUYs blocked).
# "mock" = demo data labelled MOCK; also requires ALLOW_MOCK_DATA=true.
DATA_PROVIDER=none
ALLOW_MOCK_DATA=false

# Required for the endpoints that do work (scan / cycle / orders). Min 24 chars. Generate randomly.
# Without it those endpoints are disabled. Read endpoints (state, events) need no key.
API_KEY=

# Mandatory top-10 holder rule (default 25) and applied basis: raw | adjusted
MAX_TOP10_HOLDER_PCT=25
CONCENTRATION_BASIS=raw

# Developer holdings policy (percent of supply)
DEV_WARN_PCT=5
DEV_BLOCK_PCT=10

# Risk limits (percent)
MAX_POSITION_PCT=5
STOP_LOSS_PCT=8
MAX_DAILY_LOSS_PCT=10

DATABASE_PATH=trading.db

# Background cycles every N seconds (0 = off, otherwise >= 10). Automatic SIMULATED buys are opt-in.
CYCLE_INTERVAL_S=0
AUTO_BUY_ENABLED=false
AUTO_BUY_USD=25

# Browser origins allowed to read the API (comma separated, explicit, no wildcard), e.g. your frontend URL.
CORS_ORIGINS=http://localhost:3000

# --- DATA_PROVIDER=live (real Solana data, read-only) ---
# SOLANA_RPC_URL=https://...        (required; may embed a key, so keep it on the backend host only)
# WATCHLIST_MINTS=<mint1>,<mint2>   (tokens to scan; automatic discovery is not implemented)
# RAYDIUM_API_BASE=https://api-v3.raydium.io
# ALLOW_UNOFFICIAL_PUMPFUN=false    (true = also query pump.fun's unofficial website API for the creator)
# PUMPFUN_API_BASE=https://frontend-api-v3.pump.fun
# GMGN_API_KEY= / GMGN_BASE_URL= / GMGN_AUTH_HEADER=   (accepted by the config but NOT used yet: no GMGN adapter exists)
